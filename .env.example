# Copy to .env and fill in. .env is gitignored — never commit it.

# "demo" (demo-api.kalshi.co, fake money) or "prod" (api.elections.kalshi.com).
# This kit is READ-ONLY either way: it contains no order-placing code.
KALSHI_ENV=demo

# Kalshi -> Account & security -> API Keys -> Create key
KALSHI_API_KEY_ID=YOUR_API_KEY_ID_HERE

# Path to the private key file Kalshi gave you (RSA or Ed25519 PEM).
# Keep it outside this repo, or in keys/ (gitignored). chmod 600 it.
KALSHI_PRIVATE_KEY_PATH=keys/YOUR_PRIVATE_KEY_HERE.pem

# Optional: Telegram alerts (ops/telegram.py). Leave blank to log only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
